# Used automatically by `npm run build` / `vite build` (mode=production).
# Overrides frontend/.env — so a leftover localhost value cannot ship.
#
# Public CMS origin. Must match nginx server_name and backend
# PAYLOAD_PUBLIC_SERVER_URL. Rebuild after changing this.
VITE_CMS_URL=https://demov2.iremetech.com

# Optional — contact form and email booking receipts
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — card payments
VITE_STRIPE_PUBLISHABLE_KEY=
