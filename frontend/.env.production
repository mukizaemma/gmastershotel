# Used automatically by `npm run build` / `vite build` (mode=production).
# Overrides frontend/.env — so a leftover localhost value cannot ship.
#
# Empty = same-origin /api (nginx proxies to Payload). That is required for
# https://gmastershotel.com: a baked demov2.iremetech.com URL is cross-origin
# and the browser blocks it (CORS). Rebuild after changing this.
VITE_CMS_URL=

# Optional — contact form and email booking receipts
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — card payments
VITE_STRIPE_PUBLISHABLE_KEY=
