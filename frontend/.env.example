# =============================================================================
# Frontend env — copy to .env for local `npm run dev`.
#
# VITE_* is baked into the JS at `npm run build`. Changing this file after
# a build does nothing until you build again.
#
# Production builds use frontend/.env.production (committed) so the droplet
# does not depend on copying this local file.
# =============================================================================

# LOCAL — Vite (5174) talks to Payload on 3001.
VITE_CMS_URL=http://localhost:3001
#
# PRODUCTION — do not put localhost here. Leave empty so the built site
# calls /api on the same host (nginx). Required for gmastershotel.com;
# a hardcoded demo host is cross-origin and the browser blocks it.
# See frontend/.env.production (used automatically by `vite build`).

# Optional — contact form and email booking receipts
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — card payments (publishable key is safe in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=
