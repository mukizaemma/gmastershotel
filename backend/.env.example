# =============================================================================
# Backend env — copy to .env (never commit .env)
#
#   Local:         cp backend/.env.example backend/.env
#   DigitalOcean:  cp backend/.env.production.example backend/.env
#
# Then fill secrets. `next start` reads backend/.env at runtime.
# NEXT_PUBLIC_* is baked in at `npm run build` — set it before you build.
# =============================================================================

# Long random string. Generate with:  openssl rand -hex 32
# Do not change this after the first successful start (auth tokens break).
PAYLOAD_SECRET=replace-with-a-long-random-string

# Atlas (or local Mongo). On the droplet, whitelist the droplet IP in Atlas
# Network Access or the CMS will not start.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gmastershotel?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/gmastershotel
DATABASE_URI=

# Payload/Next listens here. Nginx proxies /admin /api /_next to this port.
# Do not expose 3001 on the public firewall.
PORT=3001

# ── Browser origins ─────────────────────────────────────────────────────────
# LOCAL — used by `npm run dev` (Vite on 5174, Payload on 3001):
FRONTEND_URL=http://localhost:5174
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5174
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
#
# PRODUCTION — on the droplet replace the three lines above with:
# FRONTEND_URL=https://gmastershotel.com
# NEXT_PUBLIC_FRONTEND_URL=https://gmastershotel.com
# PAYLOAD_PUBLIC_SERVER_URL=https://gmastershotel.com
#
# FRONTEND_URL                 CORS + CSRF for the guest site; password-reset links.
# NEXT_PUBLIC_FRONTEND_URL     "View site" links in admin. Baked at `npm run build`.
# PAYLOAD_PUBLIC_SERVER_URL    Public CMS origin (same host as nginx). Media URLs,
#                              admin reset links, Payload serverURL. Use https://
#                              after Certbot — http:// will break Secure cookies.

# Email — Resend REST API (preferred). Forgot-password and booking
# notifications both use this adapter. Verify gmastershotel.com in Resend
# (or temporarily send from onboarding@resend.dev to the account email).
RESEND_API_KEY=
RESEND_FROM=noreply@gmastershotel.com
RESEND_FROM_NAME=G Masters Hotel
# Optional extra inboxes (comma-separated). Company email + active CMS
# users are always notified on new/updated reservations.
BOOKING_NOTIFY_EMAIL=
#
# SMTP fallback if RESEND_API_KEY is empty. Leave blank in local dev —
# Payload uses Ethereal and prints a preview URL in the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=noreply@gmastershotel.local
SMTP_FROM_NAME=G Masters Hotel

# Optional — leave blank until you have keys (routes return "not configured")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=RWF
USD_TO_RWF=
