# =============================================================================
# DigitalOcean production — copy to backend/.env on the droplet:
#
#   cp backend/.env.production.example backend/.env
#   nano backend/.env
#
# Then:
#   1. Set PAYLOAD_SECRET  (openssl rand -hex 32)
#   2. Set MONGODB_URI     (Atlas; whitelist this droplet's IP)
#   3. npm run build       (NEXT_PUBLIC_* below is baked in here)
#   4. npm start           (or pm2) on PORT 3001 — nginx proxies to it
#
# After Certbot, keep these as https://  — do not leave http:// or localhost.
# =============================================================================

PAYLOAD_SECRET=replace-with-a-long-random-string

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gmastershotel?retryWrites=true&w=majority
DATABASE_URI=

PORT=3001

# Guest site + CMS share https://demov2.iremetech.com (nginx).
# Redirect www → apex in nginx so CORS only needs this one origin.
FRONTEND_URL=https://demov2.iremetech.com
NEXT_PUBLIC_FRONTEND_URL=https://demov2.iremetech.com
PAYLOAD_PUBLIC_SERVER_URL=https://demov2.iremetech.com

# Required in production if staff/admin use "forgot password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=noreply@demov2.iremetech.com
SMTP_FROM_NAME=G Masters Hotel

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=RWF
USD_TO_RWF=
