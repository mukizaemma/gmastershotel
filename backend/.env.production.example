# =============================================================================
# DigitalOcean production — copy to backend/.env on the droplet:
#
#   cp backend/.env.production.example backend/.env
#   nano backend/.env
#
# Then:
#   1. Set PAYLOAD_SECRET  (openssl rand -hex 32)
#   2. Set MONGODB_URI     (Atlas; whitelist this droplet's IP)
#   3. npm run build       (NEXT_PUBLIC_* below is baked in here)
#   4. npm start           (or pm2) on PORT 3001 — nginx proxies to it
#
# After Certbot, keep these as https://  — do not leave http:// or localhost.
# =============================================================================

PAYLOAD_SECRET=replace-with-a-long-random-string

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gmastershotel?retryWrites=true&w=majority
DATABASE_URI=

PORT=3001

# Guest site + CMS share https://gmastershotel.com (nginx).
# demov2.iremetech.com remains an alias; Payload CORS also allows it.
FRONTEND_URL=https://gmastershotel.com
NEXT_PUBLIC_FRONTEND_URL=https://gmastershotel.com
PAYLOAD_PUBLIC_SERVER_URL=https://gmastershotel.com

# Resend — verify gmastershotel.com in the Resend dashboard.
# Forgot-password and booking emails (guest + admin) use this.
RESEND_API_KEY=
RESEND_FROM=noreply@gmastershotel.com
RESEND_FROM_NAME=G Masters Hotel
BOOKING_NOTIFY_EMAIL=

# SMTP fallback only if RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=noreply@gmastershotel.com
SMTP_FROM_NAME=G Masters Hotel

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=RWF
USD_TO_RWF=
